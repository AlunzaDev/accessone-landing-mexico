---
import InteriorLayout from '../layouts/InteriorLayout.astro';
import {
  MediaGallery,
  ServiceCatalog,
  type IconName,
} from '@alunzadev/accessone-ui';
import CountUp from '../components/CountUp';
import '@alunzadev/accessone-ui/styles/service-catalog.css';
import '@alunzadev/accessone-ui/styles/media.css';
const services: { icon: IconName; title: string; text: string; items?: string[] }[] = [
  { icon: 'access', title: 'Control de accesos y salidas', text: 'Sistemas para gestionar el ingreso y egreso de vehículos con tecnología de vanguardia, aprovechando mejor cada ubicación y manteniendo el control de las áreas de circulación.' },
  { icon: 'maintenance', title: 'Mantenimiento', text: 'Programas preventivos y correctivos para mantener cada estacionamiento en condiciones óptimas.', items: ['Guarniciones y señalización', 'Demarcación y pintura', 'Bacheo preventivo', 'Cambio de luminarias'] },
  { icon: 'support', title: 'Asistencia y emergencias', text: 'Apoyo discreto a los usuarios ante situaciones imprevistas dentro del estacionamiento.', items: ['Carga de baterías', 'Revisión de niveles básicos', 'Contacto con cerrajero 24 horas', 'Asistencia médica de emergencia'] },
  { icon: 'ticket', title: 'Taquillas y accesos', text: 'Control de acceso de personas para parques recreativos, cines, ferias y otras instalaciones mediante torniquetes inteligentes y validación de tickets.' },
  { icon: 'clean', title: 'Limpieza', text: 'Personal calificado para mantener las instalaciones en condiciones óptimas de limpieza, funcionamiento y presentación durante la operación.' },
  { icon: 'clock', title: 'Horarios y tarifas flexibles', text: 'Operaciones adaptables a las necesidades de cada proyecto, incluso durante las 24 horas, todos los días del año.', items: ['Cobro por hora o fracción', 'Tarifa única', 'Pensión diaria o mensual', 'Esquemas personalizados'] },
];
---
<InteriorLayout title="Servicios | AccessOne México" description="Servicios integrales para diseñar, operar y mantener estacionamientos en México.">
  <section class="page-hero"><p class="tag">Servicios</p><h1>Una operación. Todos los frentes.</h1><p>Soluciones conectadas para diseñar, equipar, operar y mantener estacionamientos en México.</p></section>
  <section class="services-intro" aria-labelledby="services-intro-title">
    <div class="services-intro-heading">
      <p class="tag">Experiencia integral</p>
      <h2 id="services-intro-title">Todo lo que un estacionamiento necesita para operar mejor.</h2>
    </div>
    <div class="services-intro-copy">
      <span aria-hidden="true"></span>
      <p>Integramos infraestructura, tecnología y atención para crear soluciones confiables, adaptables y centradas en la experiencia de cada usuario.</p>
    </div>
  </section>
  <section class="solutions services-catalog"><ServiceCatalog client:load ctaLabel="Cuéntanos sobre tu proyecto" services={services.map(({ text, ...service }) => ({ ...service, description: text }))} /></section>
  <!-- TODO media: fotos de servicios -->
  <section class="accessone-media-section" aria-labelledby="services-gallery-title">
    <div class="accessone-media-section__heading"><div><p class="tag">En campo</p><h2 id="services-gallery-title">Nuestros servicios, en acción.</h2></div></div>
    <MediaGallery items={[
      { label: 'Operación de estacionamiento', hint: 'Foto amplia' },
      { label: 'Limpieza' },
      { label: 'Asistencia al usuario' },
      { label: 'Taquillas y torniquetes' },
    ]} />
  </section>
  <section class="service-proof"><p class="tag">Presencia nacional</p><strong><CountUp client:load value={30000} prefix="+" /></strong><h2>espacios de estacionamiento</h2><p>Experiencia desarrollada en México en estacionamientos, hospitales, clubes deportivos, exposiciones y centros comerciales de la República Mexicana.</p><a href="/contacto">Cuéntanos sobre tu proyecto <b>↗</b></a></section>
</InteriorLayout>
